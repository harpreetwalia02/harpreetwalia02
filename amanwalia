public class StarPatterns {
    public static void pyramidPattern(int n) {
        for (int i = 0; i < n; i++) {
            // Print spaces
            for (int j = 0; j < n - i - 1; j++) {
                System.out.print(" ");
            }
            // Print stars
            for (int k = 0; k < 2 * i + 1; k++) {
                System.out.print("*");
            }
            // Move to the next line
            System.out.println();
        }
    }
    public static void main(String[] args) {
        pyramidPattern(5);
    }
}
